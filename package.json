{
  "name": "@ostro/database",
  "version": "1.4.6",
  "description": "Database module for OstroJS",
  "main": "build/databaseManager.js",
  "types": "build/databaseManager.d.ts",
  "files": [
    "build"
  ],
  "exports": {
    ".": {
      "types": "./build/databaseManager.d.ts",
      "default": "./build/databaseManager.js"
    },
    "./*": {
      "types": "./build/*.d.ts",
      "default": "./build/*.js"
    }
  },
  "scripts": {
    "build": "rm -rf build && npx tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "npx c8 npx jest --runInBand --no-coverage --forceExit"
  },
  "dependencies": {
    "@ostro/contracts": "^1.0.2",
    "@ostro/pagination": "^1.0.4",
    "@ostro/support": "^1.2.0",
    "fs-extra": "^8.1.0",
    "knex": "^2.3.0",
    "lodash": "^4.17.21",
    "lodash.get": "^4.4.2",
    "sqlite3": "^6.0.1"
  },
  "engines": {
    "node": ">=12.0.0"
  },
  "engineStrict": true,
  "keywords": [
    "database",
    "query builder",
    "model",
    "eloquent"
  ],
  "author": "amar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ostrojs/database.git"
  },
  "bugs": {
    "url": "https://github.com/ostrojs/database/issues"
  },
  "homepage": "https://github.com/ostrojs/database#readme",
  "devDependencies": {
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0"
  }
}
